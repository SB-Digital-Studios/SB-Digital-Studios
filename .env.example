# Public backend settings (enquiry backup copy)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PHP mailer endpoint (defaults to /api/contact.php on the same host)
VITE_CONTACT_ENDPOINT=/api/contact.php

# Optional reCAPTCHA v3 (also set RECAPTCHA_SECRET_KEY on the PHP host)
VITE_RECAPTCHA_SITE_KEY=
