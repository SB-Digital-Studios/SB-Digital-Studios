# Root deployment guard:
# If you upload the entire project, force all public traffic to dist/ only.

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite requests that already target dist/
  RewriteCond %{REQUEST_URI} !^/dist/

  # Serve file/dir from dist if it exists
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ /dist/$1 [L]

  # SPA fallback: serve built app shell from dist
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^.*$ /dist/index.html [L]
</IfModule>

# Block common sensitive files if they are requested directly
<FilesMatch "^(package(-lock)?\.json|vite\.config\.js|eslint\.config\.js|\.prettierrc)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
  php_value error_log "/home/sites/f85682043vip4uc6/logs/php.error.log"
  php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
  php_value error_log "/home/sites/f85682043vip4uc6/logs/php.error.log"
  php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit
